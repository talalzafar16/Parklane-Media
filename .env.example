# Canonical origin for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://parklanemedia.com

# Where enquiries are POSTed as JSON (Formspree, Zapier, Slack, a CRM…). Server-side only.
